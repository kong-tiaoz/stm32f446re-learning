{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug ex1",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/scripts/build.ps1",
        "-Example",
        "ex1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Build Release (choose example)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "RemoteSigned",
        "-File",
        "${workspaceFolder}/scripts/build.ps1",
        "-Configuration",
        "Release",
        "-Example",
        "${input:example}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$gcc"
    }
  ],
  "inputs": [
    {
      "id": "example",
      "type": "pickString",
      "description": "选择子例",
      "options": [
        "ex1"
      ],
      "default": "ex1"
    }
  ]
}
