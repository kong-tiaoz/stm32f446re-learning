set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(NOT ARM_GCC_BIN_DIR)
    file(GLOB _st_gcc_bins LIST_DIRECTORIES TRUE "$ENV{LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/*/bin")
    list(SORT _st_gcc_bins COMPARE NATURAL ORDER DESCENDING)
endif()
find_program(CMAKE_C_COMPILER NAMES arm-none-eabi-gcc HINTS "${ARM_GCC_BIN_DIR}" ${_st_gcc_bins} REQUIRED)
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
get_filename_component(_gcc_bin "${CMAKE_C_COMPILER}" DIRECTORY)
find_program(CMAKE_AR NAMES arm-none-eabi-ar HINTS "${_gcc_bin}" REQUIRED)
find_program(CMAKE_RANLIB NAMES arm-none-eabi-ranlib HINTS "${_gcc_bin}" REQUIRED)
find_program(CMAKE_OBJCOPY NAMES arm-none-eabi-objcopy HINTS "${_gcc_bin}" REQUIRED)
find_program(ARM_SIZE NAMES arm-none-eabi-size HINTS "${_gcc_bin}" REQUIRED)
